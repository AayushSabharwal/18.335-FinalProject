{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rqi-bench/output.schema.json",
  "title": "RQI benchmark output",
  "description": "Output format of bench/run_benchmark.jl. Scalars follow the element type T: real T serializes as a JSON number, complex T as {\"re\", \"im\"}. Non-finite floats (NaN/Inf) serialize as null, so every numeric field is nullable.",
  "type": "object",
  "required": [
    "meta",
    "matrices"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "timestamp",
        "julia_version",
        "os",
        "blas_config",
        "blas_threads",
        "args",
        "eltype",
        "methods",
        "machine",
        "flops"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "description": "Local time, yyyy-mm-ddTHH:MM:SS"
        },
        "julia_version": {
          "type": "string"
        },
        "os": {
          "type": "string",
          "description": "Sys.MACHINE, e.g. aarch64-apple-darwin24.6.0"
        },
        "blas_config": {
          "type": "string"
        },
        "blas_threads": {
          "type": "integer",
          "minimum": 1
        },
        "args": {
          "type": "object",
          "description": "Parsed CLI arguments verbatim (ArgParse Dict). NaN-valued options serialize as null.",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          }
        },
        "eltype": {
          "type": "string",
          "description": "Element type used for the computation, e.g. Float64, ComplexF64"
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "method_label for each method run, in run order"
        },
        "machine": {
          "$ref": "#/$defs/machine"
        },
        "flops": {
          "type": "object",
          "description": "FLOP instrumentation status for this run",
          "required": [
            "instrumented",
            "group"
          ],
          "properties": {
            "instrumented": {
              "type": "boolean",
              "description": "Whether LIKWID.jl was loaded and initialized (Linux only)"
            },
            "group": {
              "type": [
                "string",
                "null"
              ],
              "description": "LIKWID performance group used, e.g. FLOPS_DP; null when not instrumented"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "matrices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/matrix_entry"
      }
    }
  },
  "$defs": {
    "machine": {
      "type": "object",
      "description": "Hardware/OS the benchmark ran on",
      "required": [
        "arch",
        "cpu_model",
        "cpu_threads",
        "kernel",
        "hostname"
      ],
      "properties": {
        "arch": {
          "type": "string",
          "description": "Sys.ARCH, e.g. aarch64, x86_64"
        },
        "cpu_model": {
          "type": "string",
          "description": "First Sys.cpu_info() model string"
        },
        "cpu_threads": {
          "type": "integer",
          "minimum": 1,
          "description": "Sys.CPU_THREADS (logical cores visible to Julia)"
        },
        "kernel": {
          "type": "string",
          "description": "uname -sr, or Sys.KERNEL when uname is unavailable"
        },
        "hostname": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "flops": {
      "description": "LIKWID FLOPS_DP perfmon measurement of one pass of a phase; null when LIKWID.jl is unavailable (non-Linux, not installed, or measurement failed).",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "group",
            "dp_flops",
            "metrics",
            "events"
          ],
          "properties": {
            "group": {
              "type": "string",
              "description": "LIKWID performance group, e.g. FLOPS_DP"
            },
            "dp_flops": {
              "type": [
                "number",
                "null"
              ],
              "description": "Best-effort double-precision flop count derived from the metrics; null when not derivable"
            },
            "metrics": {
              "type": [
                "object",
                "null"
              ],
              "description": "Raw LIKWID metrics dict (group -> metric -> value)"
            },
            "events": {
              "type": [
                "object",
                "null"
              ],
              "description": "Raw LIKWID event counts dict"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "scalar": {
      "description": "A value of the matrix element type: number for real T, {re,im} for complex T; null if non-finite. Element types without a native JSON number (MultiFloats, BigFloat) serialize as full-precision decimal strings.",
      "anyOf": [
        {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        {
          "type": "object",
          "required": [
            "re",
            "im"
          ],
          "properties": {
            "re": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "im": {
              "type": [
                "number",
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "scalar_vector": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scalar"
      }
    },
    "trial_stats": {
      "type": "object",
      "description": "BenchmarkTools trial summary",
      "required": [
        "runtime_ns_median",
        "runtime_ns_min",
        "runtime_ns_samples",
        "flops"
      ],
      "properties": {
        "runtime_ns_median": {
          "type": [
            "number",
            "null"
          ]
        },
        "runtime_ns_min": {
          "type": [
            "number",
            "null"
          ]
        },
        "runtime_ns_samples": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "bytes_allocated": {
          "type": "integer",
          "minimum": 0
        },
        "alloc_count": {
          "type": "integer",
          "minimum": 0
        },
        "flops": {
          "$ref": "#/$defs/flops"
        }
      },
      "additionalProperties": false
    },
    "matrix_entry": {
      "type": "object",
      "required": [
        "file",
        "n",
        "generalized",
        "sparse",
        "nnz_A",
        "nnz_B",
        "symmetric",
        "norm_inf",
        "eltype",
        "match_tol",
        "n_starts",
        "search",
        "starts_benchmark",
        "oracle",
        "runs",
        "coverage"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "generalized": {
          "type": "boolean",
          "description": "true when the input was a 2n\u00d7n stacked pencil [A; B] and all solves ran on the generalized problem Ax = \u03bbBx"
        },
        "sparse": {
          "type": "boolean",
          "description": "true when the input was a Matrix Market (.mtx) file and all solves ran on SparseMatrixCSC operands (UMFPACK)"
        },
        "nnz_A": {
          "type": "integer",
          "minimum": 0,
          "description": "Stored nonzeros of A; n\u00b2 for dense inputs"
        },
        "nnz_B": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Stored nonzeros of B; null for standard problems, n\u00b2 for dense pencils"
        },
        "symmetric": {
          "type": "boolean"
        },
        "norm_inf": {
          "type": [
            "number",
            "null"
          ]
        },
        "eltype": {
          "type": "string"
        },
        "match_tol": {
          "type": [
            "number",
            "null"
          ],
          "description": "Tolerance for matching found eigenvalues to oracle eigenvalues"
        },
        "n_starts": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of start points (0 under --oracle-only)"
        },
        "search": {
          "type": "object",
          "description": "Search-phase configuration as actually resolved (auto-derived values included, so the run is reproducible)",
          "required": [
            "strategy"
          ],
          "properties": {
            "strategy": {
              "enum": [
                "rq",
                "grid",
                "largest",
                "none"
              ]
            },
            "search_shift": {
              "description": "Resolved shift-invert target(s) s for largest: scalar for one shift, array when multiple --search-shift values were given (one start each)",
              "anyOf": [
                {
                  "$ref": "#/$defs/scalar"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/scalar"
                  }
                }
              ]
            },
            "lo": {
              "type": [
                "number",
                "null"
              ],
              "description": "Left Gershgorin bound used by grid"
            },
            "hi": {
              "type": [
                "number",
                "null"
              ],
              "description": "Right Gershgorin bound used by grid"
            }
          },
          "additionalProperties": false
        },
        "starts_benchmark": {
          "anyOf": [
            {
              "$ref": "#/$defs/trial_stats"
            },
            {
              "type": "null"
            }
          ],
          "description": "Timing of the search-phase build_starts; null under --oracle-only"
        },
        "oracle": {
          "$ref": "#/$defs/oracle_entry"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run_entry"
          }
        },
        "coverage": {
          "type": "object",
          "description": "Per-method-label coverage summary",
          "additionalProperties": {
            "$ref": "#/$defs/coverage_entry"
          }
        }
      },
      "additionalProperties": false
    },
    "oracle_entry": {
      "type": "object",
      "required": [
        "method",
        "eltype",
        "runtime_ns_median",
        "runtime_ns_min",
        "runtime_ns_samples",
        "gc_time_ns_max",
        "bytes_allocated",
        "alloc_count",
        "maxrss_delta_bytes",
        "eigenvalues",
        "flops"
      ],
      "properties": {
        "eltype": {
          "type": "string",
          "description": "Oracle element type (promoted to >= Float64 precision)"
        },
        "runtime_ns_median": {
          "type": [
            "number",
            "null"
          ]
        },
        "runtime_ns_min": {
          "type": [
            "number",
            "null"
          ]
        },
        "runtime_ns_samples": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "gc_time_ns_max": {
          "type": [
            "number",
            "null"
          ]
        },
        "bytes_allocated": {
          "type": "integer",
          "minimum": 0
        },
        "alloc_count": {
          "type": "integer",
          "minimum": 0
        },
        "maxrss_delta_bytes": {
          "type": "integer"
        },
        "eigenvalues": {
          "$ref": "#/$defs/scalar_vector"
        },
        "flops": {
          "$ref": "#/$defs/flops"
        },
        "method": {
          "type": "string",
          "enum": [
            "dense",
            "arpack",
            "arnoldi"
          ],
          "description": "Oracle eigensolver: dense = full spectrum via eigen/QZ (generic-precision eigvals for non-BlasFloat eltype); arpack = partial (nev) via eigs, BlasFloat only; arnoldi = partial (nev) via ArnoldiMethod partialschur, any eltype"
        },
        "nev": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Eigenvalues requested from the arpack/arnoldi oracle (null for dense)"
        },
        "n_converged": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Eigenvalues actually converged by eigs/partialschur (null for dense)"
        },
        "niter": {
          "type": [
            "integer",
            "null"
          ]
        },
        "nmult": {
          "type": [
            "integer",
            "null"
          ]
        },
        "which": {
          "type": [
            "string",
            "null"
          ],
          "description": "Selection criterion (LR = largest real part, LM = nearest sigma via shift-invert)"
        },
        "sigma": {
          "$ref": "#/$defs/scalar"
        }
      },
      "additionalProperties": false
    },
    "run_entry": {
      "type": "object",
      "description": "One method's results on one matrix: init trial, iterate trial over all starts, per-start eigenpairs",
      "required": [
        "method",
        "label",
        "params",
        "n_starts",
        "init",
        "totals",
        "starts_runtime_ns_median",
        "starts_flops",
        "init_flops",
        "iterate_flops",
        "init_runtime_ns_median",
        "init_runtime_ns_min",
        "init_runtime_ns_samples",
        "init_bytes_allocated",
        "init_alloc_count",
        "iterate_runtime_ns_median",
        "iterate_runtime_ns_min",
        "iterate_runtime_ns_samples",
        "gc_time_ns_max",
        "iterate_bytes_allocated",
        "iterate_alloc_count",
        "end_to_end_runtime_ns_median",
        "maxrss_delta_bytes",
        "starts"
      ],
      "properties": {
        "method": {
          "type": "string",
          "description": "Bare algorithm name (parameter-independent)",
          "enum": [
            "fixed_shift_lu",
            "rqi_lu",
            "rqi_gmres_input_prec",
            "rqi_gmres_prev_prec"
          ]
        },
        "label": {
          "type": "string",
          "description": "method_label: algorithm plus configuration, e.g. 'rqi_gmres_prev_prec (tau=0.1)'"
        },
        "params": {
          "type": "object",
          "required": [
            "tol",
            "maxiter",
            "inner_reltol",
            "inner_abstol",
            "inner_maxiter",
            "gmres_restart",
            "power_iters",
            "search_shift",
            "seed"
          ],
          "properties": {
            "tol": {
              "type": [
                "number",
                "null"
              ]
            },
            "maxiter": {
              "type": "integer",
              "minimum": 1
            },
            "inner_reltol": {
              "type": [
                "number",
                "null"
              ]
            },
            "inner_abstol": {
              "type": [
                "number",
                "null"
              ]
            },
            "inner_maxiter": {
              "type": "integer",
              "minimum": 1
            },
            "gmres_restart": {
              "type": "integer",
              "minimum": 0
            },
            "power_iters": {
              "type": "integer",
              "minimum": 0
            },
            "search_shift": {
              "anyOf": [
                {
                  "$ref": "#/$defs/scalar"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/scalar"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "seed": {
              "type": "integer"
            },
            "tau": {
              "type": [
                "number",
                "null"
              ],
              "description": "Refactorization threshold; present only for rqi_gmres_prev_prec (null when tau=Inf)"
            }
          },
          "additionalProperties": false
        },
        "n_starts": {
          "type": "integer",
          "minimum": 1
        },
        "init": {
          "type": "object",
          "required": [
            "n_factorizations",
            "n_perturbations"
          ],
          "properties": {
            "n_factorizations": {
              "type": "integer",
              "minimum": 0
            },
            "n_perturbations": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "totals": {
          "type": "object",
          "required": [
            "outer_iterations",
            "n_shifts",
            "n_factorizations",
            "n_perturbations",
            "gmres_iterations_total",
            "gmres_stalled_solves"
          ],
          "properties": {
            "outer_iterations": {
              "type": "integer",
              "minimum": 0
            },
            "n_shifts": {
              "type": "integer",
              "minimum": 0
            },
            "n_factorizations": {
              "type": "integer",
              "minimum": 0,
              "description": "Init's first LU plus all iterate-phase factorizations"
            },
            "n_perturbations": {
              "type": "integer",
              "minimum": 0
            },
            "gmres_iterations_total": {
              "type": "integer",
              "minimum": 0
            },
            "gmres_stalled_solves": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "starts_runtime_ns_median": {
          "type": [
            "number",
            "null"
          ],
          "description": "Shared search-phase (build_starts) cost, timed once per matrix"
        },
        "starts_flops": {
          "$ref": "#/$defs/flops"
        },
        "init_flops": {
          "$ref": "#/$defs/flops"
        },
        "iterate_flops": {
          "$ref": "#/$defs/flops"
        },
        "init_runtime_ns_median": {
          "type": [
            "number",
            "null"
          ]
        },
        "init_runtime_ns_min": {
          "type": [
            "number",
            "null"
          ]
        },
        "init_runtime_ns_samples": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "init_bytes_allocated": {
          "type": "integer",
          "minimum": 0
        },
        "init_alloc_count": {
          "type": "integer",
          "minimum": 0
        },
        "iterate_runtime_ns_median": {
          "type": [
            "number",
            "null"
          ],
          "description": "All starts on one reused SolverState, including reset_state! between starts"
        },
        "iterate_runtime_ns_min": {
          "type": [
            "number",
            "null"
          ]
        },
        "iterate_runtime_ns_samples": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "gc_time_ns_max": {
          "type": [
            "number",
            "null"
          ]
        },
        "iterate_bytes_allocated": {
          "type": "integer",
          "minimum": 0
        },
        "iterate_alloc_count": {
          "type": "integer",
          "minimum": 0
        },
        "end_to_end_runtime_ns_median": {
          "type": [
            "number",
            "null"
          ],
          "description": "starts + init + iterate medians; the honest cost of the whole search"
        },
        "maxrss_delta_bytes": {
          "type": "integer"
        },
        "starts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/start_entry"
          }
        }
      },
      "additionalProperties": false
    },
    "start_entry": {
      "type": "object",
      "description": "Deterministic result of one (v0, sigma0) start; timing lives at the run level",
      "required": [
        "start_index",
        "sigma0",
        "converged",
        "fail_reason",
        "outer_iterations",
        "n_shifts",
        "n_factorizations",
        "n_perturbations",
        "gmres_iterations_total",
        "gmres_stalled_solves",
        "gmres_iterations_per_step",
        "eigenvalue",
        "final_residual",
        "residual_history",
        "shift_history",
        "oracle_nearest_eigenvalue",
        "eigenvalue_abs_error"
      ],
      "properties": {
        "start_index": {
          "type": "integer",
          "minimum": 0
        },
        "sigma0": {
          "$ref": "#/$defs/scalar"
        },
        "converged": {
          "type": "boolean"
        },
        "fail_reason": {
          "type": "string",
          "enum": [
            "None",
            "SolveFailed",
            "Diverged",
            "MaxIterations"
          ],
          "description": "RQIFail enum member name; 'None' on clean convergence"
        },
        "outer_iterations": {
          "type": "integer",
          "minimum": 0
        },
        "n_shifts": {
          "type": "integer",
          "minimum": 0
        },
        "n_factorizations": {
          "type": "integer",
          "minimum": 0
        },
        "n_perturbations": {
          "type": "integer",
          "minimum": 0
        },
        "gmres_iterations_total": {
          "type": "integer",
          "minimum": 0
        },
        "gmres_stalled_solves": {
          "type": "integer",
          "minimum": 0
        },
        "gmres_iterations_per_step": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "eigenvalue": {
          "$ref": "#/$defs/scalar"
        },
        "final_residual": {
          "type": [
            "number",
            "null"
          ]
        },
        "residual_history": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "shift_history": {
          "$ref": "#/$defs/scalar_vector"
        },
        "oracle_nearest_eigenvalue": {
          "$ref": "#/$defs/scalar"
        },
        "eigenvalue_abs_error": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "coverage_entry": {
      "type": "object",
      "required": [
        "n_eigenvalues",
        "n_found",
        "coverage",
        "oracle_indices_found",
        "eigenvalues_found",
        "found_largest",
        "total_runtime_ns_median"
      ],
      "properties": {
        "n_eigenvalues": {
          "type": "integer",
          "minimum": 1
        },
        "n_found": {
          "type": "integer",
          "minimum": 0
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "n_found / n_eigenvalues"
        },
        "oracle_indices_found": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Sorted unique 1-based indices into oracle.eigenvalues"
        },
        "eigenvalues_found": {
          "$ref": "#/$defs/scalar_vector"
        },
        "found_largest": {
          "type": "boolean",
          "description": "Whether the eigenvalue with the largest real part was found"
        },
        "total_runtime_ns_median": {
          "type": [
            "number",
            "null"
          ],
          "description": "starts + init + iterate medians for this label"
        }
      },
      "additionalProperties": false
    }
  }
}
